--- !u!114 &1683106712
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1683106707}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2170bc7d07eedfa459e6313875bf0486, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Lab6UIController
  kamazContext: {fileID: 1683106716}
  targetCamera: {fileID: 702706999}
  descriptionText: {fileID: 864282616}
  startViewPoint: {fileID: 102541404}
  kuzovViewPoint: {fileID: 356813861}
  doorViewPoint: {fileID: 643881007}
  lightsViewPoint: {fileID: 997776488}
  panelViewPoint: {fileID: 248970248}
  steeringViewPoint: {fileID: 1844174738}
  keyViewPoint: {fileID: 968136241}
  defaultSetupDescription: "\u041A\u0410\u041C\u0410\u0417 (\u0441\u0430\u043C\u043E\u0441\u0432\u0430\u043B)
    \u2014 \u044D\u0442\u043E \u0431\u043E\u043B\u044C\u0448\u0435\u0433\u0440\u0443\u0437\u043D\u044B\u0439
    \u0430\u0432\u0442\u043E\u043C\u043E\u0431\u0438\u043B\u044C-\u0441\u0430\u043C\u043E\u0441\u0432\u0430\u043B,
    \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044B\u0439
    \u0434\u043B\u044F \u043F\u0435\u0440\u0435\u0432\u043E\u0437\u043A\u0438 \u0441\u044B\u043F\u0443\u0447\u0438\u0445
    \u0433\u0440\u0443\u0437\u043E\u0432 (\u043F\u0435\u0441\u043A\u0430, \u0449\u0435\u0431\u043D\u044F,
    \u0437\u0435\u043C\u043B\u0438). \u0415\u0433\u043E \u0433\u043B\u0430\u0432\u043D\u0430\u044F
    \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u044C \u2014 \u043A\u0443\u0437\u043E\u0432,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F
    \u0433\u0438\u0434\u0440\u0430\u0432\u043B\u0438\u043A\u043E\u0439 \u0438 \u043E\u043F\u0440\u043E\u043A\u0438\u0434\u044B\u0432\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430\u0437\u0430\u0434 \u0434\u043B\u044F \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0440\u0430\u0437\u0433\u0440\u0443\u0437\u043A\u0438."
  kuzovDescription: "\u041A\u0443\u0437\u043E\u0432 \u041A\u0430\u043C\u0410\u0417\u0430
    \u0438 \u043F\u043E\u0434\u044A\u0435\u043C\u043D\u044B\u0439 \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C."
  doorDescription: "\u0414\u0432\u0435\u0440\u0438 \u043A\u0430\u0431\u0438\u043D\u044B
    \u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044F."
  lightsDescription: "\u0421\u0438\u0441\u0442\u0435\u043C\u0430 \u0432\u043D\u0435\u0448\u043D\u0435\u0433\u043E
    \u043E\u0441\u0432\u0435\u0449\u0435\u043D\u0438\u044F \u0438 \u0441\u0438\u0433\u043D\u0430\u043B\u043E\u0432."
  panelDescription: "\u041F\u0430\u043D\u0435\u043B\u044C \u043F\u0440\u0438\u0431\u043E\u0440\u043E\u0432,
    \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0430\u0442\u0435\u043B\u0438,
    \u043F\u0435\u0434\u0430\u043B\u0438 \u0438 \u0440\u044B\u0447\u0430\u0433\u0438."

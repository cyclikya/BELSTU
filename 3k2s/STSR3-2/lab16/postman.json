      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"query\": \"{ getFaculties { FACULTY FACULTY_NAME } }\"}"
        },
        "url": {
          "raw": "http://localhost:5000/graphql",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["graphql"]
        }

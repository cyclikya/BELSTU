                "in",
                "    dbo_FactDeliveries"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "TotalRevenue",
            "expression": " SUMX(FactDeliveries, FactDeliveries[TotalAmount])"
          },
          {
            "name": "DeliveryCount",
            "expression": " COUNTROWS(FactDeliveries)"
          },
          {
            "name": "AvgMargin",
            "expression": [
              " ",
              "AVERAGEX(",
              "    FactDeliveries,",
              "    (FactDeliveries[TotalAmount] - (FactDeliveries[Quantity] * RELATED(DimDeliveryType[Cost]))) / FactDeliveries[TotalAmount]",
              ")"
            ]
          }
        ]

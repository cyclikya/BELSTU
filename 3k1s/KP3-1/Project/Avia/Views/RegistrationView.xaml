<Window x:Class="Avia.Views.RegistrationView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:Avia.Converters"
        mc:Ignorable="d"
        Title="Регистрация" Height="542" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="White">
    <Window.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        
        <!-- Стиль для текстовых полей -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#1E3A8A"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        Focusable="False"
                                        HorizontalScrollBarVisibility="Hidden"
                                        VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Стиль для PasswordBox - не переопределяем Template, только стилизуем свойства -->
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#1E3A8A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        
        <!-- Стиль для DatePicker -->
        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        
        <!-- Стиль для кнопки регистрации -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E3A8A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="30,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E40AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Стиль для кнопки входа -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E0F2FE"/>
            <Setter Property="Foreground" Value="#1E3A8A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="30,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#BAE6FD"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid Height="500">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,2,0,-36">
            <Grid Margin="30,20,50,30" MinWidth="500">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <TextBlock Grid.Row="0" 
                           Text="Регистрация" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="#1E3A8A"
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,30"/>

                <!-- ФИО -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" 
                               Text="Фамилия" 
                               Foreground="#1E3A8A"
                               FontSize="14"/>
                    <TextBlock Grid.Column="2" 
                               Text="Имя" 
                               Foreground="#1E3A8A"
                               FontSize="14"/>
                    <TextBlock Grid.Column="4" 
                               Text="Отчество (необяз.)" 
                               Foreground="#1E3A8A"
                               FontSize="14"/>
                </Grid>
                <Grid Grid.Row="2" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" 
                             Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Grid.Column="2" 
                             Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Grid.Column="4" 
                             Text="{Binding MiddleName, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <!-- Серия и номер паспорта и Дата рождения -->
                <Grid Grid.Row="3" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Серия и номер паспорта" 
                                   Foreground="#1E3A8A"
                                   FontSize="14"
                                   Margin="0,0,0,8"/>
                        <TextBox Text="{Binding PassportNumber, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewTextInput="PassportTextBox_PreviewTextInput"
                                 TextChanged="PassportTextBox_TextChanged"
                                 DataObject.Pasting="PassportTextBox_Pasting"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Дата рождения" 
                                   Foreground="#1E3A8A"
                                   FontSize="14"
                                   Margin="0,0,0,8"/>
                        <DatePicker x:Name="BirthDatePicker"
                                    SelectedDate="{Binding BirthDate, Mode=TwoWay}" 
                                    Height="40" 
                                    Padding="0,0,0,0"
                                    SelectedDateChanged="BirthDatePicker_SelectedDateChanged"
                                    Loaded="BirthDatePicker_Loaded"
                                    CalendarClosed="BirthDatePicker_CalendarClosed"
                                    GotFocus="BirthDatePicker_GotFocus"/>
                    </StackPanel>
                </Grid>

                <!-- Придумайте пароль и Повторите пароль -->
                <Grid Grid.Row="4" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Придумайте пароль" 
                                   Foreground="#1E3A8A"
                                   FontSize="14"
                                   Margin="0,0,0,8"/>
                        <Grid>
                            <Border x:Name="PasswordBoxBorder" Background="White" BorderBrush="#1E3A8A" BorderThickness="1" CornerRadius="8">
                                <PasswordBox x:Name="PasswordBoxHidden" 
                                             PasswordChanged="PasswordBox_PasswordChanged"
                                             PreviewTextInput="PasswordBoxHidden_PreviewTextInput"
                                             DataObject.Pasting="PasswordBoxHidden_Pasting"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Visibility="Visible"/>
                            </Border>
                            <TextBox x:Name="PasswordBoxVisible" 
                                     Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="PasswordBoxVisible_TextChanged"
                                     PreviewTextInput="PasswordBoxVisible_PreviewTextInput"
                                     DataObject.Pasting="PasswordBoxVisible_Pasting"
                                     Visibility="Collapsed"/>
                            <TextBlock x:Name="PasswordToggleIcon"
                                       Text="👁" 
                                       FontSize="18"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="0,0,15,0"
                                       Cursor="Hand"
                                       MouseDown="PasswordToggle_MouseDown"
                                       Panel.ZIndex="1"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Повторите пароль" 
                                   Foreground="#1E3A8A"
                                   FontSize="14"
                                   Margin="0,0,0,8"/>
                        <Grid>
                            <Border x:Name="ConfirmPasswordBoxBorder" Background="White" BorderBrush="#1E3A8A" BorderThickness="1" CornerRadius="8">
                                <PasswordBox x:Name="ConfirmPasswordBoxHidden" 
                                             PasswordChanged="ConfirmPasswordBox_PasswordChanged"
                                             PreviewTextInput="PasswordBoxHidden_PreviewTextInput"
                                             DataObject.Pasting="PasswordBoxHidden_Pasting"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Visibility="Visible"/>
                            </Border>
                            <TextBox x:Name="ConfirmPasswordBoxVisible" 
                                     Text="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="ConfirmPasswordBoxVisible_TextChanged"
                                     PreviewTextInput="PasswordBoxVisible_PreviewTextInput"
                                     DataObject.Pasting="PasswordBoxVisible_Pasting"
                                     Visibility="Collapsed"/>
                            <TextBlock x:Name="ConfirmPasswordToggleIcon"
                                       Text="👁" 
                                       FontSize="18"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="0,0,15,0"
                                       Cursor="Hand"
                                       MouseDown="ConfirmPasswordToggle_MouseDown"
                                       Panel.ZIndex="1"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Сообщение об ошибке -->
                <TextBlock Grid.Row="5" 
                           Text="{Binding ErrorMessage}" 
                           Foreground="#DC2626" 
                           TextWrapping="Wrap" 
                           FontSize="12"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"
                           Margin="0,0,0,20"/>

                <!-- Кнопки -->
                <Grid Grid.Row="10" Margin="0,20,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="1"
                            Content="зарегистрироваться" 
                            Command="{Binding RegisterCommand}" 
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="150" Height="42.62" Margin="0,21,0,0"/>
                    
                    <StackPanel Grid.Column="3" Margin="0,0,0,5">
                        <TextBlock Text="Есть аккаунт?" 
                                   Foreground="#1E3A8A"
                                   FontSize="12"
                                   HorizontalAlignment="Left"
                                   Margin="0,0,0,5"/>
                        <Button Content="войти" 
                                Command="{Binding NavigateToLoginCommand}" 
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="150"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>

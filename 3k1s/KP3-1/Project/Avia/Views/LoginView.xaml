<Window x:Class="Avia.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:Avia.Converters"
        xmlns:theme="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero2"
        mc:Ignorable="d"
        Title="Вход в систему" Height="444" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White" Cursor="Hand">
    <Window.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        
        <!-- Стиль для текстовых полей -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#1E3A8A"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        Focusable="False"
                                        HorizontalScrollBarVisibility="Hidden"
                                        VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Стиль для PasswordBox - не переопределяем Template, только стилизуем свойства -->
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#1E3A8A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        
        <!-- Стиль для кнопки входа -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E3A8A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="30,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E40AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Стиль для кнопки регистрации -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E0F2FE"/>
            <Setter Property="Foreground" Value="#1E3A8A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="30,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#BAE6FD"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid Margin="40,20,40,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock Grid.Row="0" 
                       Text="Вход" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="#1E3A8A"
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,30"/>

            <!-- Поле "Серия и номер паспорта" -->
            <TextBlock Grid.Row="1" 
                       Text="Серия и номер паспорта" 
                       Foreground="#1E3A8A"
                       FontSize="14"
                       Margin="0,0,0,8"/>
            <TextBox Grid.Row="2" 
                     Text="{Binding PassportNumber, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,0,0,20"/>

            <!-- Поле "Введите пароль" -->
            <TextBlock Grid.Row="3" 
                       Text="Введите пароль" 
                       Foreground="#1E3A8A"
                       FontSize="14"
                       Margin="0,0,0,8"/>
            <Grid Grid.Row="4" Margin="0,0,0,20">
                <Border Background="White" BorderBrush="#1E3A8A" BorderThickness="1" CornerRadius="8">
                    <PasswordBox x:Name="PasswordBoxHidden" 
                                 PasswordChanged="PasswordBox_PasswordChanged"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Visibility="Visible"/>
                </Border>
                <TextBox x:Name="PasswordBoxVisible" 
                         Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="PasswordBoxVisible_TextChanged"
                         Visibility="Collapsed"/>
                <TextBlock x:Name="PasswordToggleIcon"
                           Text="👁" 
                           FontSize="18"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0,0,15,0"
                           Cursor="Hand"
                           MouseDown="PasswordToggle_MouseDown"
                           Panel.ZIndex="1"/>
            </Grid>

            <!-- Сообщение об ошибке -->
            <TextBlock Grid.Row="5" 
                       Text="{Binding ErrorMessage}" 
                       Foreground="#DC2626" 
                       TextWrapping="Wrap" 
                       FontSize="12"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"
                       Margin="0,0,0,20"/>

            <!-- Кнопки -->
            <Grid Grid.Row="7" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="1"
                        Content="войти" 
                        Command="{Binding LoginCommand}" 
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="150" Cursor="Hand" Height="42.62" Margin="0,21,0,0"/>
                
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Нет аккаунта?" 
                               Foreground="#1E3A8A"
                               FontSize="12"
                               HorizontalAlignment="Left"
                               Margin="0,0,0,5"/>
                    <Button Content="зарегистрироваться" 
                            Command="{Binding NavigateToRegistrationCommand}" 
                            Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="150"/>
                </StackPanel>
            </Grid>
        </Grid>
</Window>

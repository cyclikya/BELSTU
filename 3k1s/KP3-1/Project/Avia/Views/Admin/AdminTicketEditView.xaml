<Window x:Class="Avia.Views.Admin.AdminTicketEditView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:data="clr-namespace:Avia.Data.Entities"
        xmlns:converters="clr-namespace:Avia.Converters"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" 
        Height="550" 
        Width="550"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">
    <Window.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:ClassTypeConverter x:Key="ClassTypeConverter"/>
        <converters:TicketStatusConverter x:Key="TicketStatusConverter"/>
        
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#1E3A8A"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Пользователь:" 
                   FontSize="14" 
                   FontWeight="SemiBold"
                   Margin="0,0,0,5"/>
        <ComboBox Grid.Row="1" 
                  SelectedItem="{Binding SelectedUser}" 
                  DisplayMemberPath="LastName"
                  ItemsSource="{Binding Users}"
                  Margin="0,0,0,15"/>

        <TextBlock Grid.Row="2" 
                   Text="Рейс:" 
                   FontSize="14" 
                   FontWeight="SemiBold"
                   Margin="0,0,0,5"/>
        <ComboBox Grid.Row="3" 
                  SelectedItem="{Binding SelectedFlight}" 
                  DisplayMemberPath="FlightDisplay"
                  ItemsSource="{Binding Flights}"
                  Margin="0,0,0,15"/>

        <TextBlock Grid.Row="4" 
                   Text="Класс:" 
                   FontSize="14" 
                   FontWeight="SemiBold"
                   Margin="0,0,0,5"/>
        <ComboBox Grid.Row="5" 
                  SelectedItem="{Binding SelectedClass}" 
                  Margin="0,0,0,15">
            <ComboBox.ItemsSource>
                <x:Array Type="{x:Type data:ClassType}">
                    <data:ClassType>Economy</data:ClassType>
                    <data:ClassType>Business</data:ClassType>
                </x:Array>
            </ComboBox.ItemsSource>
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource ClassTypeConverter}}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <CheckBox Grid.Row="6" 
                  Content="Багаж" 
                  IsChecked="{Binding IncludeBaggage}" 
                  Margin="0,0,0,15"/>

        <TextBlock Grid.Row="7" 
                   Text="Статус:" 
                   FontSize="14" 
                   FontWeight="SemiBold"
                   Margin="0,0,0,5"/>
        <ComboBox Grid.Row="8" 
                  SelectedItem="{Binding SelectedStatus}" 
                  Margin="0,0,0,15">
            <ComboBox.ItemsSource>
                <x:Array Type="{x:Type data:TicketStatus}">
                    <data:TicketStatus>Active</data:TicketStatus>
                    <data:TicketStatus>Cancelled</data:TicketStatus>
                </x:Array>
            </ComboBox.ItemsSource>
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource TicketStatusConverter}}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Grid.Row="9" 
                   Text="{Binding ErrorMessage}" 
                   Foreground="Red" 
                   TextWrapping="Wrap" 
                   FontSize="14"
                   Margin="0,0,0,20"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

        <StackPanel Grid.Row="10" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="0,10,0,0">
            <Button Content="Сохранить" 
                    Command="{Binding SaveCommand}" 
                    Width="120" 
                    Height="40" 
                    Margin="5"
                    Background="#1E3A8A"
                    Foreground="White"
                    FontSize="14"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="6"
                                            Padding="15,10">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Отмена" 
                    Command="{Binding CancelCommand}" 
                    Width="120" 
                    Height="40" 
                    Margin="5"
                    Background="#E5E7EB"
                    Foreground="#1E3A8A"
                    FontSize="14"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="6"
                                            Padding="15,10">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D1D5DB"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>


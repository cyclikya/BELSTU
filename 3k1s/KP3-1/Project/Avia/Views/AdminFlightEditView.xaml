<Window x:Class="Avia.Views.AdminFlightEditView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Редактирование рейса" Height="650" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <ScrollViewer>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Откуда:" Margin="0,0,0,5"/>
            <TextBox Grid.Row="1" Text="{Binding DepartureCity, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,0,0,15" Height="30"/>

            <TextBlock Grid.Row="2" Text="Куда:" Margin="0,0,0,5"/>
            <TextBox Grid.Row="3" Text="{Binding ArrivalCity, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,0,0,15" Height="30"/>

            <TextBlock Grid.Row="4" Text="Дата вылета:" Margin="0,0,0,5"/>
            <DatePicker Grid.Row="5" SelectedDate="{Binding DepartureDate}" 
                        Margin="0,0,0,15" Height="30"/>

            <TextBlock Grid.Row="6" Text="Время вылета:" Margin="0,0,0,5"/>
            <TextBox Grid.Row="7" Text="{Binding DepartureTime, StringFormat=hh\\:mm}" 
                     Margin="0,0,0,15" Height="30"/>

            <TextBlock Grid.Row="8" Text="Дата прибытия:" Margin="0,0,0,5"/>
            <DatePicker Grid.Row="9" SelectedDate="{Binding ArrivalDate}" 
                        Margin="0,0,0,15" Height="30"/>

            <TextBlock Grid.Row="10" Text="Время прибытия:" Margin="0,0,0,5"/>
            <TextBox Grid.Row="11" Text="{Binding ArrivalTime, StringFormat=hh\\:mm}" 
                     Margin="0,0,0,15" Height="30"/>

            <TextBlock Grid.Row="12" Text="Авиакомпания:" Margin="0,0,0,5"/>
            <TextBox Grid.Row="13" Text="{Binding Airline, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,0,0,15" Height="30"/>

            <TextBlock Grid.Row="14" Text="Цена эконом:" Margin="0,0,0,5"/>
            <TextBox Grid.Row="15" Text="{Binding EconomyPrice, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,0,0,15" Height="30"/>

            <TextBlock Grid.Row="16" Text="Цена бизнес:" Margin="0,0,0,5"/>
            <TextBox Grid.Row="17" Text="{Binding BusinessPrice, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,0,0,15" Height="30"/>

            <TextBlock Grid.Row="18" Text="Места эконом:" Margin="0,0,0,5"/>
            <TextBox Grid.Row="19" Text="{Binding EconomySeats, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,0,0,15" Height="30"/>

            <TextBlock Grid.Row="20" Text="Места бизнес:" Margin="0,0,0,5"/>
            <TextBox Grid.Row="21" Text="{Binding BusinessSeats, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,0,0,15" Height="30"/>

            <TextBlock Grid.Row="22" Text="Цена багажа:" Margin="0,0,0,5"/>
            <TextBox Grid.Row="23" Text="{Binding BaggagePrice, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,0,0,15" Height="30"/>

            <TextBlock Grid.Row="24" Text="{Binding ErrorMessage}" 
                       Foreground="Red" TextWrapping="Wrap" 
                       Margin="0,0,0,10"/>

            <StackPanel Grid.Row="25" Orientation="Horizontal" 
                        HorizontalAlignment="Center">
                <Button Content="Сохранить" Command="{Binding SaveCommand}" 
                        Width="100" Height="35" Margin="5"/>
                <Button Content="Отмена" Command="{Binding CancelCommand}" 
                        Width="100" Height="35" Margin="5"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>


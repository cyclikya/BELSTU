<Window x:Class="Avia.Views.BuyTicketView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:data="clr-namespace:Avia.Data.Entities"
        xmlns:converters="clr-namespace:Avia.Converters"
        mc:Ignorable="d"
        Title="Покупка билета" 
        Height="700" 
        Width="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">
    <Window.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:ClassTypeConverter x:Key="ClassTypeConverter"/>
        <DropShadowEffect x:Key="DropShadowEffect" BlurRadius="10" ShadowDepth="3" Opacity="0.3"/>

        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,8"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1E3A8A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="40,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E40AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#1E3A8A"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="40,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D1D5DB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#1E3A8A"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#1E3A8A"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#1E3A8A"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        Focusable="False"
                                        HorizontalScrollBarVisibility="Hidden"
                                        VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Фоновый градиент -->

        <!-- Основная карточка -->
        <Border Background="White" 
                CornerRadius="15" 
                Padding="40,30,40,0" 
                Margin="20,20,20,50"
                Effect="{StaticResource DropShadowEffect}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="✈" FontSize="40" Foreground="#1E3A8A" Margin="0,0,15,0"/>
                    <TextBlock Text="Бронирование билета" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="#1E3A8A"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Информация о рейсе -->
                <Border Grid.Row="1" 
                        Background="#F3F4F6" 
                        CornerRadius="10" 
                        Padding="20,15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Откуда" 
                                       FontSize="12" 
                                       Foreground="#666" 
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding Flight.DepartureCity}" 
                                       FontSize="18" 
                                       FontWeight="SemiBold" 
                                       Foreground="#1E3A8A"/>
                        </StackPanel>

                        <TextBlock Grid.Row="0" Grid.Column="1" 
                                   Text="→" 
                                   FontSize="24" 
                                   Foreground="#1E3A8A" 
                                   VerticalAlignment="Center" 
                                   Margin="20,0"/>

                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Куда" 
                                       FontSize="12" 
                                       Foreground="#666" 
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding Flight.ArrivalCity}" 
                                       FontSize="18" 
                                       FontWeight="SemiBold" 
                                       Foreground="#1E3A8A"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,15,0,0">
                            <TextBlock Text="Дата вылета" 
                                       FontSize="12" 
                                       Foreground="#666" 
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding Flight.DepartureDate, StringFormat='{}{0:dd.MM.yyyy}'}" 
                                       FontSize="14" 
                                       Foreground="#1E3A8A"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,15,0,0">
                            <TextBlock Text="Время вылета" 
                                       FontSize="12" 
                                       Foreground="#666" 
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding Flight.DepartureTime, StringFormat='{}{0:hh\\:mm}'}" 
                                       FontSize="14" 
                                       Foreground="#1E3A8A"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,10,0,0">
                            <TextBlock Text="Авиакомпания" 
                                       FontSize="12" 
                                       Foreground="#666" 
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding Flight.Airline}" 
                                       FontSize="14" 
                                       Foreground="#1E3A8A"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Класс и количество мест -->
                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Класс обслуживания" 
                                   FontSize="16" 
                                   FontWeight="SemiBold" 
                                   Foreground="#1E3A8A" 
                                   Margin="0,0,0,10"/>
                        <ComboBox SelectedItem="{Binding SelectedClass}" VerticalAlignment="Center">
                            <ComboBox.ItemsSource>
                                <x:Array Type="{x:Type data:ClassType}">
                                    <data:ClassType>Economy</data:ClassType>
                                    <data:ClassType>Business</data:ClassType>
                                </x:Array>
                            </ComboBox.ItemsSource>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <Binding Converter="{StaticResource ClassTypeConverter}"/>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Количество мест" 
                                   FontSize="16" 
                                   FontWeight="SemiBold" 
                                   Foreground="#1E3A8A" 
                                   Margin="0,0,0,10"/>
                        <TextBox Text="{Binding SeatsCount, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewTextInput="NumberOnlyTextBox_PreviewTextInput"/>
                    </StackPanel>
                </Grid>

                <!-- Багаж -->
                <Border Grid.Row="3" 
                        Background="#F3F4F6" 
                        CornerRadius="8" 
                        Padding="15,0,15,0" Height="40" Margin="0,0,0,10">
                    <CheckBox Content="Добавить багаж" 
                              IsChecked="{Binding IncludeBaggage}" 
                              FontSize="14" 
                              FontWeight="Medium" VerticalAlignment="Center"/>
                </Border>

                <!-- Доступные места -->
                <StackPanel Grid.Row="4">
                    <TextBlock Text="Доступно мест" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Foreground="#1E3A8A" 
                               Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding AvailableSeats}" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="#059669"/>
                </StackPanel>

                <!-- Итоговая цена -->
                <Border Grid.Row="5" 
                        Background="#1E3A8A" 
                        CornerRadius="10" 
                        Padding="20,15" 
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" 
                                   Text="Итоговая цена:" 
                                   FontSize="18" 
                                   FontWeight="SemiBold" 
                                   Foreground="White" 
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" 
                                   Text="{Binding TotalPrice, StringFormat='{}{0:F0} р.'}" 
                                   FontSize="28" 
                                   FontWeight="Bold" 
                                   Foreground="White"/>
                    </Grid>
                </Border>

                <!-- Сообщение об ошибке -->
                <TextBlock Grid.Row="6" 
                           Text="{Binding ErrorMessage}" 
                           Foreground="#DC2626" 
                           TextWrapping="Wrap" 
                           FontSize="14"
                           Margin="0,0,0,10"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

                <!-- Кнопки -->
                <StackPanel Grid.Row="7" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <Button Content="Купить билет" 
                            Command="{Binding BuyCommand}" 
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,15,0"/>
                    <Button Content="Отмена" 
                            Command="{Binding CancelCommand}" 
                            Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>


<Window x:Class="Avia.Views.ClientMainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Avia.Views"
        xmlns:converters="clr-namespace:Avia.Converters"
        xmlns:entities="clr-namespace:Avia.Data.Entities"
        mc:Ignorable="d"
        Title="Авиабилеты" 
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <DropShadowEffect x:Key="DropShadowEffect" BlurRadius="10" ShadowDepth="3" Opacity="0.3"/>

        <DataTemplate DataType="{x:Type entities:Flight}">
            <views:FlightCard Flight="{Binding}" 
                              BuyTicketCommand="{Binding DataContext.BuyTicketForFlightCommand, RelativeSource={RelativeSource AncestorType=Window, Mode=FindAncestor}}"
                              FlightService="{Binding DataContext.FlightService, RelativeSource={RelativeSource AncestorType=Window, Mode=FindAncestor}}"/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type entities:Ticket}">
            <views:TicketCard Ticket="{Binding}" 
                              CancelTicketCommand="{Binding DataContext.CancelTicketByIdCommand, RelativeSource={RelativeSource AncestorType=Window, Mode=FindAncestor}}"/>
        </DataTemplate>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E40AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1E3A8A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="40,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E40AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#1E3A8A"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        Focusable="False"
                                        HorizontalScrollBarVisibility="Hidden"
                                        VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#1E3A8A"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Фоновый градиент -->
        <Grid.Background>
            <SolidColorBrush Color="#78D0F3"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Навигация -->
        <Border Grid.Row="0" Background="#1E3A8A" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="Личный кабинет" Command="{Binding NavigateToTicketsCommand}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Ellipse Width="12" Height="12" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding UserDisplayName}" 
                               Foreground="White" 
                               FontSize="14"
                               VerticalAlignment="Center"
                               Margin="0,0,15,0"/>
                    <Button Content="Выйти" Command="{Binding LogoutCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Героическая секция -->
        <Grid Grid.Row="1" x:Name="HeroSection" RenderTransformOrigin="0.495,0.467" Height="188">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Самолет и заголовок -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,81">
                <TextBlock Text="✈" FontSize="80" Foreground="White" Margin="0,0,20,0"/>
                <TextBlock Text="АВИА-БИЛЕТЫ" 
                           FontSize="48" 
                           FontWeight="Bold" 
                           Foreground="White"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Описания -->
            <Grid Grid.Row="1" Margin="50,0,50,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
            </Grid>

            <!-- Статистика -->
            <Border 
                    Background="#1E3A8A" 
                    Opacity="0.8" 
                    CornerRadius="10" 
                    Padding="40,15" 
                    Margin="50,119,50,24">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="500 партнёров" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,0,60,0"/>
                    <TextBlock Text="2 000 000 пассажиров" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,0,60,0"/>
                    <TextBlock Text="100 стран" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Форма поиска -->
        <Border Grid.Row="2" 
                Background="White" 
                Opacity="0.95" 
                CornerRadius="15" 
                Padding="30,10,30,10" 
                Margin="50,0,50,20"
                Effect="{StaticResource DropShadowEffect}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                           Text="Поиск билетов" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="#1E3A8A"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <!-- Поля поиска -->
                <Grid Grid.Row="1" x:Name="HomeSearchFields">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Откуда" Foreground="#1E3A8A" FontSize="16" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding DepartureCity, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0,10,0">
                        <TextBlock Text="Куда" Foreground="#1E3A8A" FontSize="16" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding ArrivalCity, UpdateSourceTrigger=PropertyChanged}" Cursor="Hand"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="10,0,10,0">
                        <TextBlock Text="Дата вылета" Foreground="#1E3A8A" FontSize="16" Margin="0,0,0,5"/>
                        <DatePicker SelectedDate="{Binding DepartureDate, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="10,0,10,0">
                        <TextBlock Text="Дата прилёта" Foreground="#1E3A8A" FontSize="16" Margin="0,0,0,5"/>
                        <DatePicker SelectedDate="{Binding ArrivalDate, Mode=TwoWay}"/>
                    </StackPanel>
                </Grid>
                <Button Grid.Row="1" 
                        Content="найти" 
                        Style="{StaticResource PrimaryButton}"
                        VerticalAlignment="Bottom"
                        Command="{Binding SearchCommand}" Margin="0,0,26,0" Width="187" HorizontalAlignment="Right" Cursor="Hand" Height="40" Padding="40,-3,40,2"/>
            </Grid>
        </Border>

        <!-- Основной контент -->
        <Grid Grid.Row="3" Margin="50,0,50,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Боковая панель фильтров -->
            <Border Grid.Column="0" 
                    Background="#1E3A8A" 
                    Opacity="0.9" 
                    CornerRadius="15" 
                    Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Фильтры" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="White"
                                   Margin="0,0,0,10"/>

                        <!-- Цена -->
                        <TextBlock Text="Цена" 
                                   FontSize="18" 
                                   FontWeight="SemiBold" 
                                   Foreground="White"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" 
                                     Text="{Binding FilterPriceFrom, UpdateSourceTrigger=PropertyChanged}" 
                                     Height="35"
                                     PreviewTextInput="NumberOnlyTextBox_PreviewTextInput" Margin="0,1,0,-1" Padding="12,5,12,0"/>
                            <TextBox Grid.Column="2" 
                                     Text="{Binding FilterPriceTo, UpdateSourceTrigger=PropertyChanged}" 
                                     Height="35"
                                     PreviewTextInput="NumberOnlyTextBox_PreviewTextInput" Margin="0,1,0,-1" Padding="12,5,12,0"/>
                        </Grid>
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="от" Foreground="White" FontSize="12" Margin="0,-6,0,6"/>
                            <TextBlock Grid.Column="2" Text="до" Foreground="White" FontSize="12" Margin="0,-6,0,6"/>
                        </Grid>

                        <!-- Количество свободных мест (минимум) -->
                        <TextBlock Text="Свободных мест (мин.)" 
                                   FontSize="18" 
                                   FontWeight="SemiBold" 
                                   Foreground="White"/>
                        <TextBox Text="{Binding FilterMinSeats, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="35"
                                 PreviewTextInput="NumberOnlyTextBox_PreviewTextInput" Padding="12,5,12,0"/>

                        <!-- Компания -->
                        <TextBlock Text="Компания" 
                                   FontSize="18" 
                                   FontWeight="SemiBold" 
                                   Foreground="White" Margin="0,0,0,-1"/>
                        <ComboBox SelectedItem="{Binding FilterCompany, Mode=TwoWay}" 
                                  ItemsSource="{Binding AvailableCompanies}"
                                  Height="35" Padding="12,0,12,0" VerticalAlignment="Center"/>

                        <!-- Дополнительные фильтры -->
                        <Grid Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <CheckBox Content="Дешевле" IsChecked="{Binding FilterCheaper}"/>
                                <CheckBox Content="Дороже" IsChecked="{Binding FilterMoreExpensive}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <CheckBox Content="Утро" IsChecked="{Binding FilterMorning}"/>
                                <CheckBox Content="День" IsChecked="{Binding FilterDay}"/>
                                <CheckBox Content="Вечер" IsChecked="{Binding FilterEvening}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Результаты поиска -->
            <ScrollViewer Grid.Column="2" 
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding DisplayedItems}" Cursor="Hand"/>
                    <TextBlock Text="Подходящих рейсов не найдено. Измените фильтры или перезапустите приложение."
                               Margin="10"
                               FontSize="16"
                               Foreground="White"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasFlights}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
